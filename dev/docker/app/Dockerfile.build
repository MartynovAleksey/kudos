# syntax=docker/dockerfile:1.7
#
# BUILD image — compiles the Spring Boot fat-jar (and the JRE healthcheck class)
# and exports them to the host. The runtime image is built separately from these
# artifacts by Dockerfile.runtime, so no build tooling ever lands in the runtime.
#
#   DOCKER_BUILDKIT=1 docker build -f dev/docker/app/Dockerfile.build \
#     --output type=local,dest=dist .
#   -> dist/kudos-0.1.0.jar, dist/healthcheck.jar, dist/kudos-spark-plugin-0.1.0.jar
#
# The optional security-scan stages live here too (they scan the built jar):
#   DOCKER_BUILDKIT=1 docker build -f dev/docker/app/Dockerfile.build --target trivy-report \
#     --output type=local,dest=. .
#   DOCKER_BUILDKIT=1 docker build -f dev/docker/app/Dockerfile.build --target owasp-report \
#     --secret id=owasp_key,src=$HOME/OWASP-API.key --output type=local,dest=. .
FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml .
RUN echo 'Downloading Maven dependencies (this can take several minutes on the first build)...' && \
    mvn -B -Dstyle.color=never -DskipTests dependency:go-offline
COPY src src
RUN echo 'Compiling kudos...' && \
    mvn -B -Dstyle.color=never -DskipTests package
# The Spark UI hook is a separate project with its own pom: it is loaded by a
# Spark driver, not by this application, and shares none of its dependencies.
COPY spark-plugin spark-plugin
# Its dependencies (spark-core and friends) are not the application's, so they are
# not in the layer above; a cache mount keeps a plugin edit from re-downloading
# them, the way the scan stages below cache theirs.
RUN --mount=type=cache,target=/root/.m2 \
    echo 'Compiling the Spark UI plugin...' && \
    mvn -B -Dstyle.color=never -DskipTests -f spark-plugin/pom.xml package
# Scan scripts live in the build stage so the optional scan stages below inherit
# them; copied after packaging so editing a script does not bust the build cache.
COPY dev/scripts scripts
# Precompile the container healthcheck into a small jar: the distroless runtime is
# a JRE (no compiler), so it can run a .class/.jar but not a single-file .java.
# A jar bundles the anonymous inner classes too (a bare .class would miss them).
COPY dev/docker/app/HealthCheck.java .
RUN javac -d /workspace/health HealthCheck.java && \
    jar --create --file /workspace/healthcheck.jar --main-class HealthCheck -C /workspace/health .

# --- OWASP dependency-check ---------------------------------------------------
# The NVD API key is provided as a BuildKit secret (a file), mounted only for the
# scan command and never written into a layer or the build history.
FROM build AS owasp-scan
RUN apt-get update && apt-get install -y --no-install-recommends python3 && \
    rm -rf /var/lib/apt/lists/*
# The NVD database and the plugin jars are cached under ~/.m2, so re-runs are
# fast and an interrupted first download resumes instead of restarting.
RUN --mount=type=secret,id=owasp_key,required=false \
    --mount=type=cache,target=/root/.m2 \
    OWASP_API_KEY_FILE=/run/secrets/owasp_key bash scripts/scan-owasp.sh

# Export-only stage: its filesystem is just the report, so
# `--output type=local` drops owasp.md straight into the destination directory.
FROM scratch AS owasp-report
COPY --from=owasp-scan /workspace/owasp.md /owasp.md

# --- Trivy --------------------------------------------------------------------
FROM build AS trivy-scan
# Bring the trivy binary in from its official image; add python3 for rendering.
COPY --from=aquasec/trivy:latest /usr/local/bin/trivy /usr/local/bin/trivy
RUN apt-get update && apt-get install -y --no-install-recommends python3 && \
    rm -rf /var/lib/apt/lists/*
# Cache Trivy's vulnerability DB so re-runs skip the ~100 MB download.
RUN --mount=type=cache,target=/root/.cache/trivy bash scripts/scan-trivy.sh

FROM scratch AS trivy-report
COPY --from=trivy-scan /workspace/trivy.md /trivy.md

# --- Default target: export the build artifacts to the host -------------------
# `--output type=local,dest=dist` writes these straight into ./dist. Must stay last.
FROM scratch AS artifacts
COPY --from=build /workspace/target/kudos-0.1.0.jar /kudos-0.1.0.jar
COPY --from=build /workspace/healthcheck.jar /healthcheck.jar
# Goes into the Kyuubi image's Spark jars/, not into the runtime image.
COPY --from=build /workspace/spark-plugin/target/kudos-spark-plugin-0.1.0.jar /kudos-spark-plugin-0.1.0.jar
