set -eu

# Ozone mints the S3 secret at runtime and publishes it to the shared volume; the
# S3 output plugin picks up AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from the
# environment. No keytab is needed: the S3 Gateway authenticates the signature,
# not a Kerberos ticket.
until test -r /shared/s3-credentials.env; do sleep 2; done
. /shared/s3-credentials.env
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY

mkdir -p /var/lib/fluent-bit/s3

exec /fluent-bit/bin/fluent-bit --config=/fluent-bit/etc/fluent-bit.conf
