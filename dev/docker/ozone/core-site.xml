<configuration>
  <!-- UGI is initialized before Ozone loads ozone-site.xml, therefore the
       authentication mode must live in Hadoop's core-site.xml as well. -->
  <property>
    <name>hadoop.security.authentication</name>
    <value>kerberos</value>
  </property>
  <property>
    <name>hadoop.security.authorization</name>
    <value>true</value>
  </property>
  <!-- Kyuubi launches each Spark engine as the session user and the engine then
       reaches Ozone through a proxy user, so the OM has to accept the
       impersonation. Without these the engine fails to start with
       "is not allowed to impersonate". -->
  <property>
    <name>hadoop.proxyuser.admin.hosts</name>
    <value>*</value>
  </property>
  <property>
    <name>hadoop.proxyuser.admin.groups</name>
    <value>*</value>
  </property>
  <property>
    <name>hadoop.proxyuser.kyuubi.hosts</name>
    <value>*</value>
  </property>
  <property>
    <name>hadoop.proxyuser.kyuubi.groups</name>
    <value>*</value>
  </property>
  <property>
    <name>hadoop.security.auth_to_local</name>
    <value>
      RULE:[2:$1@$0](.*@TEST.LOCAL)s/@.*//
      RULE:[1:$1@$0](.*@TEST.LOCAL)s/@.*//
      DEFAULT
    </value>
  </property>
  <!-- Ozone client settings, kept in core-site.xml (not just ozone-site.xml)
       because Iceberg's HadoopFileIO builds a plain org.apache.hadoop.conf.
       Configuration, which loads core-site.xml but not ozone-site.xml. Ozone 2.2's
       shaded filesystem jar therefore never sees ozone-site.xml, so a client
       (e.g. Gravitino) would otherwise default to RATIS/THREE and fail to name the
       OM's Kerberos principal on this single-node stand. Harmless for the Ozone
       server, which reads the full ozone-site.xml. -->
  <property>
    <name>ozone.om.kerberos.principal</name>
    <value>om/_HOST@TEST.LOCAL</value>
  </property>
  <property>
    <name>ozone.om.kerberos.principal.pattern</name>
    <value>*</value>
  </property>
  <property>
    <name>ozone.security.enabled</name>
    <value>true</value>
  </property>
  <!-- Match the server's single-node write path (RATIS/ONE). A STAND_ALONE client
       request would force STANDALONE pipelines, which never allocate on one node. -->
  <property>
    <name>ozone.replication</name>
    <value>1</value>
  </property>
  <property>
    <name>ozone.replication.type</name>
    <value>RATIS</value>
  </property>
</configuration>
