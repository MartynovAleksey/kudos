set -euo pipefail

# Do not submit credentials until the freshly installed KDC is active. Early
# retries are counted by FreeIPA and can lock admin during the first boot.
until systemctl is-active --quiet ipa.service &&
  {
    {
      test -r /shared/admin.keytab &&
        kinit -kt /shared/admin.keytab admin@TEST.LOCAL 2>/dev/null
    } || echo "${IPA_TEST_PASSWORD}" | kinit admin@TEST.LOCAL 2>/dev/null
  }; do
  sleep 5
done

until ipa user-show admin >/dev/null 2>&1; do
  sleep 2
done

# Two UI roles are intentionally enough for the disposable reference stand.
# FreeIPA remains the source of membership; the application never keeps a list
# of privileged login names.
if ! ipa user-show analyst >/dev/null 2>&1; then
  printf '%s\n%s\n' "${IPA_ANALYST_PASSWORD}" "${IPA_ANALYST_PASSWORD}" \
    | ipa user-add analyst --first=Analyst --last=User --password
fi
# `ipa user-add --password` marks the initial password as expired.  A browser
# client cannot complete FreeIPA's interactive password-change flow, so make
# this disposable test account usable for the documented credentials.
# FreeIPA returns a non-zero code when the desired value is already stored.
ipa user-mod analyst --password-expiration=20380101000000Z || true
ipa group-add kudos-administrators --desc='KUDOS UI administrators' || true
if ! ipa group-show kudos-administrators | grep -q 'Member users:.*admin'; then
  ipa group-add-member kudos-administrators --users=admin
fi

# Fresh realms already use IPA_TEST_PASSWORD as their installer password. Make
# a user keytab from that same password only when it is absent or stale. On
# subsequent boots neither the password nor its Kerberos keys are changed.
if ! echo "${IPA_TEST_PASSWORD}" | kinit admin@TEST.LOCAL 2>/dev/null ||
  ! kinit -kt /shared/admin.keytab admin@TEST.LOCAL 2>/dev/null; then
  rm -f /shared/admin.keytab.new
  printf '%s\n%s\n' "${IPA_TEST_PASSWORD}" "${IPA_TEST_PASSWORD}" \
    | ipa-getkeytab \
      -P \
      -s freeipa.test.local \
      -p admin@TEST.LOCAL \
      -k /shared/admin.keytab.new \
      -D 'cn=Directory Manager' \
      -w "${IPA_DM_PASSWORD}"
  mv /shared/admin.keytab.new /shared/admin.keytab
fi

echo "${IPA_TEST_PASSWORD}" | kinit admin@TEST.LOCAL
ipa host-add kyuubi.test.local --force || true
ipa service-add kyuubi/kyuubi.test.local --force || true

for host in hdfs.test.local ozone.test.local hbase.test.local trino.test.local \
  sparkhistory.test.local flink.test.local; do
  ipa host-add "$host" --force || true
done

service_principals=(
  # Kyuubi's REST frontend serves its web UI over SPNEGO.
  HTTP/kyuubi.test.local
  nn/hdfs.test.local
  dn/hdfs.test.local
  HTTP/hdfs.test.local
  om/ozone.test.local
  scm/ozone.test.local
  dn/ozone.test.local
  HTTP/ozone.test.local
  hbase/hbase.test.local
  HTTP/hbase.test.local
  HTTP/trino.test.local
  # The history server reads event logs over Kerberos and serves its own UI
  # and REST API over SPNEGO.
  spark/sparkhistory.test.local
  HTTP/sparkhistory.test.local
  # Flink JobManager and History Server write and read completed-job archives in
  # Ozone under this identity.
  flink/flink.test.local
)

for principal in "${service_principals[@]}"; do
  ipa service-add "$principal" --force || true
done

# Kyuubi 1.10 test image runs on Java 8, which does not understand the newer
# AES-SHA2 Kerberos enctype selected by JDK 21 clients. Keep test tickets on
# the AES-SHA1 enctypes supported by both runtimes.
keytab_enctypes='aes256-cts-hmac-sha1-96,aes128-cts-hmac-sha1-96'
if test -s /shared/kyuubi.keytab; then
  ipa-getkeytab \
    -r \
    -s freeipa.test.local \
    -p kyuubi/kyuubi.test.local@TEST.LOCAL \
    -k /shared/kyuubi.keytab.new \
    -D 'cn=Directory Manager' \
    -w "${IPA_DM_PASSWORD}"
  mv /shared/kyuubi.keytab.new /shared/kyuubi.keytab
else
  ipa-getkeytab \
    -s freeipa.test.local \
    -p kyuubi/kyuubi.test.local@TEST.LOCAL \
    -k /shared/kyuubi.keytab \
    -D 'cn=Directory Manager' \
    -w "${IPA_DM_PASSWORD}" \
    -e "${keytab_enctypes}"
fi

for principal in "${service_principals[@]}"; do
  file="/shared/${principal//\//-}.keytab"
  if test -s "$file"; then
    ipa-getkeytab \
      -r \
      -s freeipa.test.local \
      -p "$principal@TEST.LOCAL" \
      -k "$file.new" \
      -D 'cn=Directory Manager' \
      -w "${IPA_DM_PASSWORD}"
    mv "$file.new" "$file"
  else
    ipa-getkeytab \
      -s freeipa.test.local \
      -p "$principal@TEST.LOCAL" \
      -k "$file" \
      -D 'cn=Directory Manager' \
      -w "${IPA_DM_PASSWORD}" \
      -e "${keytab_enctypes}"
  fi
done

# Trino uses a stable, service-specific filename instead of exposing the
# generic FreeIPA principal filename in its coordinator configuration.
install -m 0644 /shared/HTTP-trino.test.local.keytab /shared/trino.keytab

# The Flink containers run as the unprivileged flink user (uid 9999), unlike the
# other services that read their keytab as root. Make just the Flink keytab
# world-readable so Flink can log in. Test-only realm; see README security notes.
if test -s /shared/flink-flink.test.local.keytab; then
  chmod 0644 /shared/flink-flink.test.local.keytab
fi

cat > /shared/krb5.conf <<'EOF'
[libdefaults]
default_realm = TEST.LOCAL
dns_lookup_kdc = false
rdns = false

[realms]
TEST.LOCAL = {
  kdc = freeipa.test.local
  admin_server = freeipa.test.local
}

[domain_realm]
.test.local = TEST.LOCAL
test.local = TEST.LOCAL
EOF

# TLS material for the application, issued by this realm's own CA so the
# certificate chains to something the stand can verify rather than being a
# self-signed one nothing trusts.
app_host=app.test.local
if ! test -s /shared/app-tls.p12; then
  ipa host-add "$app_host" --force || true
  ipa service-add "HTTP/$app_host" --force || true

  work="$(mktemp -d)"
  # ipa-getcert would need certmonger running in this container; requesting the
  # certificate directly keeps the bootstrap to one shot.
  # The SAN must name only principals the realm knows: FreeIPA refuses a request
  # carrying a subjectAltName it cannot tie to a host. Clients reach the app as
  # app.test.local (the test scripts map the loopback to it), so that one name
  # is enough.
  openssl req -newkey rsa:2048 -nodes \
    -keyout "$work/app.key" \
    -out "$work/app.csr" \
    -subj "/O=TEST.LOCAL/CN=$app_host" \
    -addext "subjectAltName=DNS:$app_host"
  ipa cert-request "$work/app.csr" \
    --principal "HTTP/$app_host" \
    --certificate-out "$work/app.crt"

  openssl pkcs12 -export \
    -inkey "$work/app.key" \
    -in "$work/app.crt" \
    -certfile /etc/ipa/ca.crt \
    -name app \
    -passout pass:changeit \
    -out "$work/app-tls.p12"
  install -m 0644 "$work/app-tls.p12" /shared/app-tls.p12
  # Clients verify the application against this, not against a pinned cert.
  install -m 0644 /etc/ipa/ca.crt /shared/ca.crt
  rm -rf "$work"
fi

chmod 0644 /shared/*.keytab /shared/krb5.conf

# The application holds no keytab, so it must not even be able to see the
# cluster's service keytabs. Publish only what it needs — its TLS material and
# krb5.conf — on a separate volume that the app container mounts instead of the
# shared keytab volume.
if test -d /app-secrets; then
  install -m 0644 /shared/app-tls.p12 /app-secrets/app-tls.p12
  install -m 0644 /shared/ca.crt /app-secrets/ca.crt
  install -m 0644 /shared/krb5.conf /app-secrets/krb5.conf
fi

# Hue needs one test-user ticket to demonstrate its File Browser. Do not mount
# the shared service-keytab volume into Hue: it contains principals unrelated
# to this reference component.
if test -d /hue-secrets; then
  install -m 0644 /shared/admin.keytab /hue-secrets/admin.keytab
  install -m 0644 /shared/ca.crt /hue-secrets/ca.crt
  install -m 0644 /shared/krb5.conf /hue-secrets/krb5.conf
fi
