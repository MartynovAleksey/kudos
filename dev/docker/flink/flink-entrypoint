# Wraps the stock Flink entrypoint to give it a Hadoop + Ozone classpath and to
# wait for the Kerberos material Flink logs in with, so completed-job archives
# can be written to and read from Ozone.
set -euo pipefail

export HADOOP_HOME=/opt/hadoop
export HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop
# Flink is shipped Hadoop-free; its Hadoop file-system integration needs Hadoop
# on the classpath, and the plain Ozone filesystem jar (added to this Hadoop)
# provides ofs://.
export HADOOP_CLASSPATH="$(/opt/hadoop/bin/hadoop classpath)"

# Flink logs in with this keytab at startup; wait until FreeIPA has issued it and
# written the shared krb5.conf.
until test -r /shared/flink-flink.test.local.keytab && test -r /shared/krb5.conf; do
  sleep 2
done

exec /docker-entrypoint.sh "$@"
