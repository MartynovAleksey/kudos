# The Iceberg warehouse S3 secret is minted by Ozone at runtime (setsecret can't
# pin a fixed value) and published to the shared volume. Export it so Trino's
# ${ENV:KUDOS_S3_SECRET} substitution in catalog/iceberg.properties resolves at
# startup. Trino doesn't depend_on ozone, so wait for the file to appear.
set -euo pipefail

until test -r /shared/s3-credentials.env; do sleep 2; done
. /shared/s3-credentials.env
export KUDOS_S3_SECRET="$AWS_SECRET_ACCESS_KEY"

exec /usr/lib/trino/bin/run-trino
