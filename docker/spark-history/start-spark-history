set -euo pipefail

export SPARK_HOME=/opt/spark
export HADOOP_CONF_DIR=/opt/spark/conf
export KRB5_CONFIG=/shared/krb5.conf
export SPARK_HISTORY_OPTS="${SPARK_HISTORY_OPTS:-} -Djava.security.krb5.conf=/shared/krb5.conf"
export SPARK_NO_DAEMONIZE=true

until test -r /shared/spark-sparkhistory.test.local.keytab &&
  test -r /shared/HTTP-sparkhistory.test.local.keytab &&
  test -r /shared/krb5.conf; do
  sleep 2
done

kinit -kt /shared/spark-sparkhistory.test.local.keytab \
  spark/sparkhistory.test.local@TEST.LOCAL

# Run the server in the foreground: the launcher script would fork and leave
# this container with no process to supervise.
exec "$SPARK_HOME/bin/spark-class" org.apache.spark.deploy.history.HistoryServer
