set -eu

# Vault Agent rotates PEM material in place. Rebuild the PKCS#12 files
# atomically, so Trino and the JDBC driver never observe a partial store.
while :; do
  if test -s /vault/secrets/trino.pem && test -s /vault/secrets/ca.crt; then
    openssl pkcs12 -export -in /vault/secrets/trino.pem -inkey /vault/secrets/trino.pem \
      -name trino -passout pass:changeit -out /tls/trino.p12.new
    keytool -importcert -noprompt -storetype PKCS12 \
      -keystore /tls/truststore.p12.new -storepass changeit \
      -alias vault-ca -file /vault/secrets/ca.crt
    # The server key is readable only by Trino (uid 1000); the CA-only
    # truststore is also readable by the unprivileged KUDOS application.
    chown 1000:1000 /tls/trino.p12.new
    chmod 0400 /tls/trino.p12.new
    chmod 0444 /tls/truststore.p12.new
    mv /tls/trino.p12.new /tls/trino.p12
    mv /tls/truststore.p12.new /tls/truststore.p12
  fi
  sleep 30
done
