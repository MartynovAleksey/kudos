[Unit]
Description=Create disposable FreeIPA identities and Kerberos keytabs for tests
Wants=ipa-server-configure-first.service
After=ipa-server-configure-first.service
Before=multi-user.target

[Service]
Type=oneshot
# systemd does not propagate Docker service environment to units. These are
# deliberately non-secret credentials for this disposable test realm only.
Environment="IPA_ADMIN_INITIAL_PASSWORD=K8SparkAdmin2026Secure!"
Environment="IPA_DM_PASSWORD=DirectoryManager1"
Environment="IPA_TEST_PASSWORD=K8SparkAdmin2026Secure!"
ExecStart=/usr/local/sbin/bootstrap-test-identities
RemainAfterExit=yes

[Install]
WantedBy=container-ipa.target
